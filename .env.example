# Placeholder-only backend/deployment configuration. Local preview needs none.
# Copy to an ignored .env file and populate locally; never put secrets in VITE_*.

AWS_PROFILE=your-scoped-profile
AWS_ACCOUNT_ID=
AWS_REGION=ap-southeast-7
BEDROCK_REGION=us-east-1
BEDROCK_INFERENCE_PROFILE_ID=us.amazon.nova-micro-v1:0
READING_MODE=local
LOCAL_NETWORK_QUOTA=on
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Use temporary CLI credentials / role federation, not keys in this file.
# Runtime secrets, if introduced, must use an appropriate server-side secret store.
